<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="#121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔥 EXTREME VOICE BOOSTER 🔥"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FF6D00"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: Stopped 🔴"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp"/>

    <!-- Live UI Show / Gain Display -->
    <TextView
        android:id="@+id/tvLiveGain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Boost Level: 1.0x (Normal)"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#00E676"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Adjust Loudness (1x to 50x Max)"
        android:textColor="#B0BEC5"
        android:layout_marginBottom="8dp"/>

    <!-- High range SeekBar -->
    <SeekBar
        android:id="@+id/seekBarVolume"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="49"
        android:progress="0"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnToggle"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:text="START ULTRA BOOSTER"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#2962FF"/>

</LinearLayout>
